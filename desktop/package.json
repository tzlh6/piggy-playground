{
  "version": "4.4.1",
  "build": {
    "appId": "local.piggy.playground",
    "portable": {
      "artifactName": "猪猪游乐场-4.4.1-Win7兼容.exe"
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "app/assets/pig.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "files": [
      "app/**/*",
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "lan.cjs"
    ],
    "productName": "猪猪游乐场",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "./build/afterPack.cjs"
  },
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node test.cjs && node test-sound.cjs && node test-arcade.cjs && node test-new-games.cjs && node test-challenge.cjs && node test-roulette.cjs && node test-click.cjs && node test-doudizhu.cjs && node test-doudizhu-net.cjs && node tools/test-lan.cjs && node test-heist.cjs",
    "test:heist": "node test-heist.cjs",
    "build:web": "python build-single.py ../build/猪猪游乐场v4.4.1.html",
    "build:pigs": "node make-pigs.cjs",
    "build:win": "electron-builder --win portable --ia32 --publish never",
    "playtest": "node tools/playtest-click.cjs",
    "manifest": "node tools/make-update-manifest.cjs"
  },
  "name": "piggy-playground",
  "author": "Piggy Playground",
  "description": "Offline piggy arcade (Windows 7+ compatible) with online content updates",
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "pe-library": "^1.0.1",
    "resedit": "^2.0.3"
  },
  "license": "MIT"
}
